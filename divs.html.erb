    $("div").on("click", function(event) {
      event.preventDefault();

      // const isInsideContainer = mainContainer.contains(event.target);
      const isInsideContainer = mainContainer.contains(event.target);
      console.log('isInsideContainer', isInsideContainer)
      if (isInsideContainer) {
        // Create a new div inside the clicked target
        createDivInside(event.target);
      } else {
        // Wrap the main container in a new div
        alert("wrapping")
        wrapDiv(mainContainer);
      }
    })


    function createDivInside(targetDiv) {
      const newDiv = document.createElement('div');
      newDiv.classList.add('flex', 'items-center', 'justify-center', 'animated-move');
      newDiv.addEventListener('click', function(event) {
        event.stopPropagation(); // Prevent the event from bubbling up to the parent divs
        createDivInside(newDiv);
      });
      targetDiv.appendChild(newDiv);
    }

    function wrapDiv(targetDiv) {
      alert('wrapping')
      const wrapperDiv = document.createElement('div');
      wrapperDiv.classList.add('w-full', 'h-full', 'flex', 'items-center', 'justify-center', 'animated-move');
      targetDiv.parentNode.replaceChild(wrapperDiv, targetDiv);

      const isInsideContainer = targetDiv.contains(event.target);

      targetDiv.addEventListener('click', function(event) {
        if (isInsideContainer) {
          // Create a new div inside the clicked target
          createDivInside(event.target);
        } else {
        }
      })

      wrapperDiv.appendChild(targetDiv);
    }


    setInterval(function() {
      let x = window.innerWidth / 2 - 100 + Math.random(200) * 100;
      let y = window.innerHeight / 2 - 20 + Math.random(40) * 100;
      const event = new MouseEvent('click', {
          bubbles: true,
          cancelable: true,
          clientX: x,
          clientY: y,
          view: window
        });
      document.elementFromPoint(x, y).dispatchEvent(event);
    }, 10)
  </script>