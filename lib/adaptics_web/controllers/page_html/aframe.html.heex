<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hello World · A-Frame</title>
    <script src="https://aframe.io/releases/1.6.0/aframe.min.js"></script>
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: #f5ede0;
      }
    </style>
  </head>
  <body>
    <a-scene background="color: #f5ede0">
      <a-assets>
        <a-asset-item
          id="characters"
          src="/models/characters.glb"
        ></a-asset-item>
      </a-assets>

      <!-- Lighting: warm key from upper-left, cool ambient fill -->
      <a-light
        type="ambient"
        color="#cdd6e0"
        intensity="0.6"
      ></a-light>
      <a-light
        type="directional"
        color="#fff3e0"
        intensity="0.9"
        position="-4 6 3"
        castShadow="true"
      ></a-light>

      <!-- Ground plane with soft shadow -->
      <a-plane
        position="0 0 -3"
        rotation="-90 0 0"
        width="30"
        height="30"
        color="#ece2d2"
        shadow="receive: true"
      ></a-plane>

      <!-- The Blender characters -->
      <a-entity
        gltf-model="#characters"
        position="0 0 -3"
        scale="2 2 2"
        shadow="cast: true"
      ></a-entity>

      <!-- Floating title label -->
      <a-text
        value="Hello World"
        align="center"
        color="#5a4a3a"
        width="8"
        position="0 3 -3"
      ></a-text>

      <!-- Warm sky -->
      <a-sky color="#f5ede0"></a-sky>

      <!-- Camera with WASD + look controls, positioned to face the characters -->
      <a-entity
        position="0 1.6 2"
        camera
        look-controls
        wasd-controls
      ></a-entity>
    </a-scene>
  </body>
</html>
