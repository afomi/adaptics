<div
  id="angles-container"
  style="width: 100%; height: 100vh; background: #0a0a0f;">
</div>

<div
  id="angles-controls"
  style="position: absolute; top: 20px; left: 20px; z-index: 100; color: #fff; font-family: monospace;">
  <div style="margin-bottom: 10px;">
    <label>
      <input
        type="radio"
        name="start-position"
        value="center" />
      Start at center (0, 0)
    </label>
    <span style="font-size: 10px; color: #888;"> (bounces back through center)</span>
  </div>
  <div style="margin-bottom: 10px;">
    <label>
      <input
        type="radio"
        name="start-position"
        value="edge"
        checked />
      Start at edge (-1, 0)
    </label>
  </div>
  <div style="margin-bottom: 10px;">
    <label>
      Angle (degrees):
      <input
        type="number"
        id="angle-input"
        value="45"
        min="0"
        max="360"
        step="1"
        style="width: 60px; background: #222; color: #fff; border: 1px solid #444; padding: 4px;" />
    </label>
  </div>
  <button
    id="start-animation"
    style="background: #2a6; color: #fff; border: none; padding: 8px 16px; cursor: pointer; margin-right: 8px;">
    Start
  </button>
  <button
    id="reset-animation"
    style="background: #666; color: #fff; border: none; padding: 8px 16px; cursor: pointer;">
    Reset
  </button>
  <div
    id="reflection-count"
    style="margin-top: 10px; font-size: 12px;">
    Reflections: 0
  </div>
</div>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    window.angles();
  });
</script>
