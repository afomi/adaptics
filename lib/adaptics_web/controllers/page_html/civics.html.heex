<style>
  .civics-panel {
    position: absolute;
    top: 24px;
    left: 24px;
    z-index: 100;
    max-width: 300px;
    padding: 20px 22px;
    color: #d8dcec;
    background: rgba(11, 14, 26, 0.82);
    border: 1px solid rgba(216, 210, 192, 0.18);
    border-radius: 4px;
    backdrop-filter: blur(6px);
    font-family: ui-monospace, "SF Mono", Menlo, monospace;
  }
  .civics-title {
    margin: 0 0 2px 0;
    font-family: Palatino, "Iowan Old Style", Georgia, serif;
    font-size: 21px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #e8e4d4;
  }
  .civics-subtitle {
    margin: 0 0 14px 0;
    font-size: 10.5px;
    line-height: 1.5;
    color: #8890a8;
  }
  .civics-slider-label {
    display: block;
    margin-bottom: 4px;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #a8a090;
  }
  .civics-panel input[type="range"] {
    width: 100%;
    margin: 0 0 14px 0;
    accent-color: #e8a33d;
  }
  #civics-layers {
    border-top: 1px solid rgba(216, 210, 192, 0.14);
    padding-top: 10px;
  }
  .civics-layer-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 3.5px 4px;
    font-size: 11.5px;
    cursor: pointer;
    border-radius: 3px;
    transition: background 0.15s, opacity 0.2s;
  }
  .civics-layer-row:hover {
    background: rgba(216, 210, 192, 0.08);
  }
  .civics-layer-off {
    opacity: 0.32;
  }
  .civics-swatch {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    flex-shrink: 0;
  }
  #civics-stats {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid rgba(216, 210, 192, 0.14);
    font-size: 10px;
    line-height: 1.6;
    color: #6a7288;
  }
  .civics-hint {
    margin: 10px 0 0 0;
    font-size: 10px;
    color: #6a7288;
  }
</style>

<div
  id="civics-container"
  style="width: 100%; height: 100vh; background: #0b0e1a;">
</div>

<div
  class="civics-panel">
  <h3
    class="civics-title">
    Layers of Civics
  </h3>
  <p
    class="civics-subtitle">
    One city, thirteen strata.
    Every layer is a view of the same shared model — from land and water to conversation.
  </p>
  <label
    class="civics-slider-label"
    for="civics-explode">
    Collapse · Explode
  </label>
  <input
    type="range"
    id="civics-explode"
    min="0"
    max="100"
    value="0" />
  <div
    id="civics-layers">
  </div>
  <div
    id="civics-stats">
  </div>
  <p
    class="civics-hint">
    Click a layer to toggle it.
    Hover to isolate it.
    Drag to orbit, scroll to zoom.
  </p>
</div>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    window.civics();
  });
</script>
