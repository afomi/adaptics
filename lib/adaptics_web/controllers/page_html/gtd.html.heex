<style>
  body {
    margin: 0;
    padding: 0;
    overflow: hidden;
    background: #f5f5f3;
  }

  #gtd-canvas {
    display: block;
    position: fixed;
    inset: 0;
    cursor: pointer;
  }

  #gtd-ui {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 10;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  }

  #gtd-wordmark {
    position: absolute;
    top: 2rem;
    left: 2.5rem;
    font-weight: 400;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #000;
  }

  #gtd-subtitle {
    position: absolute;
    top: 2rem;
    right: 2.5rem;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    color: #999;
    text-align: right;
    line-height: 1.6;
  }
</style>

<canvas id="gtd-canvas"></canvas>

<div id="gtd-ui">
  <div id="gtd-wordmark">GTD</div>
  <div id="gtd-subtitle">50,000 ft</div>
</div>

<script>
(function () {
  const canvas = document.getElementById('gtd-canvas');
  const ctx = canvas.getContext('2d');
  const subtitle = document.getElementById('gtd-subtitle');

  // GTD altitudes: outermost = 50k ft (index 0), innermost = runway (index 5)
  // zoomTarget: zoom value [0..1] that frames this ring + runway together
  // fadeAt: zoom value at which this ring starts fading out (outer rings fade first)
  const ALTITUDES = [
    { label: '50,000 ft', horizon: 'life purpose',    note: 'purpose & principles',  r: 1.00, width: 1.2, alpha: 0.55, zoomTarget: 0.00, fadeAt: 0.05 },
    { label: '40,000 ft', horizon: '3–5 years',       note: 'vision',                r: 0.82, width: 1.2, alpha: 0.52, zoomTarget: 0.20, fadeAt: 0.22 },
    { label: '30,000 ft', horizon: '1–2 years',       note: '1–2 year goals',        r: 0.66, width: 1.2, alpha: 0.50, zoomTarget: 0.38, fadeAt: 0.40 },
    { label: '20,000 ft', horizon: 'yearly',          note: 'areas of responsibility', r: 0.52, width: 1.2, alpha: 0.48, zoomTarget: 0.54, fadeAt: 0.56 },
    { label: '10,000 ft', horizon: 'monthly/weekly',  note: 'current projects',      r: 0.39, width: 1.2, alpha: 0.46, zoomTarget: 0.70, fadeAt: 0.72 },
    { label: 'runway',    horizon: 'daily',            note: 'current actions / day', r: 0.27, width: 2.0, alpha: 0.85, zoomTarget: 1.00, fadeAt: 999  },
  ];

  let zoom = 0;
  let targetZoom = 0;
  let hoveredIndex = -1;
  let selectedIndex = 0; // which ring is the "outer" target; runway is always inner
  let W, H, cx, cy, baseR, originCy;

  // For a selected ring index, compute the scale and cx that places:
  //   runway right edge  at W * 1/8
  //   selected right edge at W * 7/8
  // Solving: cx + rSel * scale = W*7/8  AND  cx + rRun * scale = W*1/8
  //   => scale = (W*7/8 - W*1/8) / (rSel - rRun) * (1/baseR)
  //   => cx    = W*1/8 - rRun * baseR * scale
  function frameForIndex(idx) {
    const rSel = ALTITUDES[idx].r;
    const rRun = ALTITUDES[ALTITUDES.length - 1].r; // runway
    if (rSel === rRun) {
      // clicked runway — just show runway arc at left anchor
      const scale = (W * 0.75) / (baseR * rRun * 0.5);
      return { scale, frameCx: W * 0.125 - rRun * baseR * scale };
    }
    const span = W * 0.75; // W*7/8 - W*1/8
    const scale = span / ((rSel - rRun) * baseR);
    const frameCx = W * 0.125 - rRun * baseR * scale;
    return { scale, frameCx };
  }

  // zoomed-out state: rings centered in left 2/3, scale=1
  const OUT_SCALE = 1;

  function resize() {
    W = canvas.width  = window.innerWidth;
    H = canvas.height = window.innerHeight;
    originCy = H / 2;
    baseR = Math.min(W, H) * 0.42;
  }

  function easeInOut(t) {
    return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
  }

  // return pixel radius of a ring given explicit scale
  function ringRadius(alt, scale) {
    return alt.r * baseR * scale;
  }

  // find which ring index the point (px, py) is nearest to, within a threshold
  function nearestRing(px, py, zoomEased) {
    const dist = Math.sqrt((px - cx) ** 2 + (py - cy) ** 2);
    let best = -1;
    let bestDelta = Infinity;
    for (let i = 0; i < ALTITUDES.length; i++) {
      const r = ringRadius(ALTITUDES[i], zoomEased);
      const delta = Math.abs(dist - r);
      const threshold = Math.max(12, ALTITUDES[i].width * 6);
      if (delta < threshold && delta < bestDelta) {
        bestDelta = delta;
        best = i;
      }
    }
    return best;
  }

  // find nearest ring using current live scale
  function nearestRing(px, py) {
    const dist = Math.sqrt((px - cx) ** 2 + (py - cy) ** 2);
    let best = -1;
    let bestDelta = Infinity;
    for (let i = 0; i < ALTITUDES.length; i++) {
      const r = ringRadius(ALTITUDES[i], currentScale);
      const delta = Math.abs(dist - r);
      const threshold = Math.max(14, ALTITUDES[i].width * 6);
      if (delta < threshold && delta < bestDelta) {
        bestDelta = delta;
        best = i;
      }
    }
    return best;
  }

  canvas.addEventListener('mousemove', (e) => {
    hoveredIndex = nearestRing(e.clientX, e.clientY);
    canvas.style.cursor = hoveredIndex >= 0 ? 'pointer' : 'default';
  });

  canvas.addEventListener('click', (e) => {
    const idx = nearestRing(e.clientX, e.clientY);
    if (idx >= 0) {
      selectedIndex = idx;
      targetZoom = ALTITUDES[idx].zoomTarget;
      subtitle.textContent = ALTITUDES[idx].label;
    }
  });

  // scroll nudges targetZoom for fine control
  window.addEventListener('wheel', (e) => {
    e.preventDefault();
    targetZoom = Math.max(0, Math.min(1, targetZoom + e.deltaY * 0.0008));
    // find nearest altitude snap
    let nearIdx = 0;
    let nearDist = Infinity;
    for (let i = 0; i < ALTITUDES.length; i++) {
      const d = Math.abs(ALTITUDES[i].zoomTarget - targetZoom);
      if (d < nearDist) { nearDist = d; nearIdx = i; }
    }
    selectedIndex = nearIdx;
    hoveredIndex = -1;
  }, { passive: false });

  function drawRing(alt, idx, zoomEased) {
    const r = ringRadius(alt, zoomEased);
    const isHovered = idx === hoveredIndex;
    const isRunway = alt.label === 'runway';

    // each ring fades out as zoom passes its own fadeAt threshold
    // outer rings have lower fadeAt so they disappear first
    let alpha = alt.alpha;
    if (isRunway) {
      alpha = 0.85 + zoomEased * 0.15;
    } else {
      const fadeWindow = 0.18;
      const t = (zoomEased - alt.fadeAt) / fadeWindow;
      alpha *= Math.max(0, 1 - t);
    }
    if (isHovered) alpha = Math.min(1, alpha * 1.8 + 0.3);
    if (alpha <= 0.005) return;

    const lineWidth = alt.width
      + (isRunway ? zoomEased * 4 : 0)
      + (isHovered ? 1.5 : 0);

    ctx.beginPath();
    ctx.arc(cx, cy, r, 0, Math.PI * 2);
    ctx.strokeStyle = isHovered
      ? `rgba(0, 0, 0, ${alpha})`
      : `rgba(20, 20, 20, ${alpha})`;
    ctx.lineWidth = lineWidth;
    ctx.stroke();

    // two-line label: altitude + time horizon
    if (alpha > 0.06 && r < W * 1.2) {
      const labelAlpha = isHovered ? Math.min(alpha, 0.9) : Math.min(alpha * 1.4, 0.7);
      const horizonAlpha = labelAlpha * 0.6;
      const lx = cx + r + 10;
      if (lx < W - 10) {
        ctx.save();
        ctx.textAlign = 'left';

        // primary label
        ctx.font = isHovered
          ? `500 11px 'Helvetica Neue', Helvetica, Arial, sans-serif`
          : `11px 'Helvetica Neue', Helvetica, Arial, sans-serif`;
        ctx.fillStyle = `rgba(60, 60, 60, ${labelAlpha})`;
        ctx.textBaseline = 'bottom';
        ctx.fillText(alt.label, lx, cy - 2);

        // horizon sub-label
        ctx.font = `10px 'Helvetica Neue', Helvetica, Arial, sans-serif`;
        ctx.fillStyle = `rgba(120, 120, 120, ${horizonAlpha})`;
        ctx.textBaseline = 'top';
        ctx.fillText(alt.horizon, lx, cy + 2);

        ctx.restore();
      }
    }
  }

  function frame() {
    zoom += (targetZoom - zoom) * 0.06;
    const zoomEased = easeInOut(zoom);
    cx = computeCx(zoomEased);
    cy = originCy;

    ctx.clearRect(0, 0, W, H);
    ctx.fillStyle = '#f5f5f3';
    ctx.fillRect(0, 0, W, H);

    for (let i = 0; i < ALTITUDES.length; i++) {
      drawRing(ALTITUDES[i], i, zoomEased);
    }

    requestAnimationFrame(frame);
  }

  window.addEventListener('resize', resize);
  resize();
  frame();
})();
</script>
