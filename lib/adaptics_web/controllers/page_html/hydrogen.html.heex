<div
  id="hydrogen-container"
  style="width: 100%; height: 100vh;">
</div>

<div
  style="position: absolute; top: 20px; left: 20px; z-index: 100; color: #fff; font-family: monospace; background: rgba(5,5,16,0.85); padding: 16px; border-radius: 8px; border: 1px solid #333;">
  <h3 style="margin: 0 0 12px 0; font-size: 14px; color: #ffcc44;">
    E = Δmc² — Hydrogen Fusion
  </h3>
  <div style="margin-bottom: 12px;">
    <label style="font-size: 11px; color: #8888aa;">
      Mass deficit scale:
      <span
        id="mass-scale-label"
        style="color: #ccddff;">
        1.0×
      </span>
    </label>
    <br />
    <input
      type="range"
      id="mass-scale"
      min="0.1"
      max="5"
      step="0.1"
      value="1"
      style="width: 200px; margin-top: 4px;" />
  </div>
  <button
    id="fusion-start"
    style="background: #2a6; color: #fff; border: none; padding: 8px 16px; cursor: pointer; margin-right: 8px; border-radius: 4px;">
    Fuse
  </button>
  <button
    id="fusion-reset"
    style="background: #666; color: #fff; border: none; padding: 8px 16px; cursor: pointer; border-radius: 4px;">
    Reset
  </button>
  <div
    id="hydrogen-stats"
    style="margin-top: 16px; font-size: 12px; color: #ccddff; line-height: 1.6;">
  </div>
</div>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    window.hydrogenEnergy();
  });
</script>
