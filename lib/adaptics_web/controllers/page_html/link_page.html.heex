<style>
  body {
    background-color: #f0f0f0;
    color: #444;
  }
  a {
    color: #08f;
  }

  .label {
    background-color: #fff;
    border: 1px solid #000;
    padding: 0.1em;
    font-family: sans-serif;
    font-size: 2.5em;
    font-weight: bold;
    /* opacity: 0.9; */
    opacity: 1.0;
  }

  .css-renderer {
    border: 2px solid red;
    position: "absolute";
    top: "0";
  }

  .button-bar {
    position: absolute;
    bottom: 12px;
    left: 24px;
    z-index: 9000;
  }
  .toggle-button {
    position: relative;
  }

  *[data-tx] {
    border-bottom: 2px solid black;
    border: 1px solid #E5E5E5;
    display: inline-block;
    position: relative;
    margin-bottom: 2px;
    padding-left: 1rem;
    padding-right: 1rem;

  }

  *[data-tx]:hover {
    border-bottom: 2px solid pink;
    display: inline-block;
    opacity: 0.38;
    margin-bottom: 1px;
  }


  .container {
    position: relative;
    display: inline-block;
  }

  .hover-item {
    /* width: 200px; */
    /* height: 100px; */
    background-color: #F4F4F4;
    text-align: center;
    /* line-height: 100px; */
    cursor: pointer;
  }

  .overlay {
    position: absolute;
    top: 8px;
    left: 24px;
    width: 480px;
    height: 300px;
    background-color: rgba(0, 0, 0, 0.7);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s;
    z-index: 999;
  }

  .container:hover .overlay {
      opacity: 1;
  }

  .row {
    border: 1px solid black;
  }

</style>

<div class="row">
  <div class="container">
    <div class="hover-item" data-tx="020202020200030320032020332">
      Data tx
    </div>
    <div class="overlay">Run script</div>
  </div>
</div>

<div class="container ui-template">
  <div class="hover-item" data-tx="020202020200030320032020332">
    Data tx 2
  </div>
  <div class="overlay">Fancy jpeg</div>
</div>

<button id="add-element">Add element</button>

<script>
  // txids based on schema.org
  // WYSIWYG + sCrypt IDE features to add logic
  function copyElement() {
      const originalContainer = document.querySelector('.container.ui-template');

      debugger
      if (originalContainer) {
          // Create a deep copy of the container
          const containerCopy = originalContainer.cloneNode(true);
          var text = containerCopy.querySelector(".hover-item")
          text.innerText = "new thing"
          containerCopy.className = "container"
          // Append the copied container to the wrapper div
          document.querySelector('body').appendChild(containerCopy);
      }

  }

  // this function should evolve with every new type of event
  // as its own case
  function emitEvent(object, id, action, notes = null) {
    // emitEvent("element", "id", "copy")
    if(object == "element" && id == "id" && action == "copy") {
      copyElement()
    }
  }

  window.addEventListener("DOMContentLoaded", (event) => {
    var z = document.getElementById("add-element")

    // debugger
    z.addEventListener("click", function(e) {
      emitEvent("element", "id", "copy")
    })
  });

</script>