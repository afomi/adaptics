<div
  id="neighborhood-container"
  style="width: 100%; height: 100vh;">
</div>

<div
  id="neighborhood-controls"
  style="position: absolute; top: 20px; left: 20px; z-index: 100; color: #fff; font-family: monospace; background: rgba(10,10,26,0.8); padding: 16px; border-radius: 8px; border: 1px solid #333; max-width: 260px;">
  <h3 style="margin: 0 0 8px 0; font-size: 14px; color: #ccddff;">
    Neighborhood
  </h3>
  <p style="margin: 0 0 12px 0; font-size: 11px; color: #8888aa;">
    Figures with identity and connection state on a shared ground.
  </p>
  <p style="margin: 0 0 4px 0; font-size: 11px; color: #8888aa;">
    Click a figure to take its point of view.
  </p>
  <p style="margin: 0 0 4px 0; font-size: 11px; color: #8888aa;">
    Visibility is a function of relationship: neighbors are lit, strangers fade.
  </p>
  <p style="margin: 0; font-size: 11px; color: #8888aa;">
    Drag to orbit, scroll to zoom.
  </p>
  <div
    id="neighborhood-stats"
    style="margin-top: 12px; font-size: 12px; color: #66ffaa;">
  </div>
</div>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    window.neighborhood();
  });
</script>
