<style>
  .net-panel,
  .net-sidebar {
    position: absolute;
    top: 52px;
    z-index: 10;
    background: rgba(15, 23, 42, 0.92);
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 10px 12px;
    color: #94a3b8;
    font: 12px system-ui, sans-serif;
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: calc(100vh - 64px);
    overflow-y: auto;
  }
  .net-panel {
    left: 12px;
    width: 250px;
  }
  .net-sidebar {
    right: 12px;
    width: 260px;
    gap: 2px;
  }
  .net-title {
    margin: 0;
    color: #f1f5f9;
    font-size: 14px;
    font-weight: 600;
  }
  .net-sub {
    margin: 0;
    font-size: 11px;
    line-height: 1.45;
    color: #64748b;
  }
  .net-label {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #64748b;
    margin-top: 4px;
  }
  .net-label span:last-child {
    color: #f1f5f9;
  }
  .net-panel select {
    background: #1e293b;
    color: #f1f5f9;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 3px 4px;
    font-size: 11px;
    cursor: pointer;
  }
  .net-panel input[type="range"] {
    width: 100%;
    accent-color: #facc15;
  }
  .net-check {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    cursor: pointer;
  }
  .net-check input {
    accent-color: #facc15;
  }
  .net-btn-group {
    display: flex;
    gap: 4px;
  }
  .net-btn {
    flex: 1 1 auto;
    padding: 4px 8px;
    font: inherit;
    font-size: 11px;
    color: #e2e8f0;
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 4px;
    cursor: pointer;
  }
  .net-btn:hover {
    background: #263449;
  }
  .net-btn-active {
    color: #0b1020;
    background: #facc15;
    border-color: #facc15;
  }
  .net-stats {
    border-top: 1px solid #334155;
    padding-top: 6px;
    font-size: 11px;
    line-height: 1.7;
  }
  .net-stat {
    display: flex;
    justify-content: space-between;
  }
  .net-stat span:last-child {
    color: #f1f5f9;
  }
  .net-hint {
    margin: 0;
    font-size: 10px;
    color: #64748b;
    line-height: 1.5;
  }
  .net-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 4px;
    border-radius: 4px;
    cursor: pointer;
    color: #94a3b8;
  }
  .net-row:hover,
  .net-row-hover {
    background: #1e3a5f;
    color: #e2e8f0;
  }
  .net-row-future {
    opacity: 0.35;
  }
  .net-swatch {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .net-name {
    flex: 0 0 56px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .net-bar {
    flex: 1;
    height: 4px;
    background: #1e293b;
    border-radius: 2px;
    overflow: hidden;
  }
  .net-bar span {
    display: block;
    height: 100%;
    transition: width 0.3s;
  }
  .net-since {
    font-size: 10px;
    color: #64748b;
    flex: 0 0 30px;
    text-align: right;
  }
  .net-level {
    flex: 0 0 22px;
    height: 20px;
    padding: 0;
    font: inherit;
    font-size: 12px;
    line-height: 1;
    color: #94a3b8;
    background: transparent;
    border: 1px solid #334155;
    border-radius: 4px;
    cursor: pointer;
  }
  .net-level-shared {
    color: #facc15;
    border-color: #facc15;
  }
  .net-level-full {
    color: #0b1020;
    background: #facc15;
    border-color: #facc15;
  }
</style>

<div
  id="network-container"
  style="width: 100%; height: 100vh; background: #0b1020;">
</div>

<div
  class="net-panel">
  <h3
    class="net-title">
    Your network
  </h3>
  <p
    class="net-sub">
    You are the center and always active.
    Connections ring you; each has a network one hop out and one layer up.
    Distance can follow tie strength.
  </p>

  <div
    class="net-label">
    <span>
      Sort connections by
    </span>
  </div>
  <select
    id="net-sort">
  </select>
  <label
    class="net-check">
    <input
      type="checkbox"
      id="net-distance" />
    Distance = tie strength
  </label>

  <div
    class="net-label">
    <span>
      Year
    </span>
    <span
      id="net-year-value">
    </span>
  </div>
  <input
    type="range"
    id="net-year" />
  <button
    id="net-play"
    class="net-btn">
    Play the years
  </button>

  <div
    class="net-label">
    <span>
      Activate every network
    </span>
  </div>
  <div
    id="net-activate-all"
    class="net-btn-group">
    <button
      class="net-btn"
      data-level="off">
      ○ Off
    </button>
    <button
      class="net-btn"
      data-level="shared">
      ◐ Shared
    </button>
    <button
      class="net-btn"
      data-level="full">
      ● Full
    </button>
  </div>

  <div
    class="net-label">
    <span>
      Shared means overlap on
    </span>
  </div>
  <div
    id="net-shared">
    <label
      class="net-check">
      <input
        type="checkbox"
        data-attr="context" />
      Same context as that connection
    </label>
    <label
      class="net-check">
      <input
        type="checkbox"
        data-attr="interests" />
      An interest of yours
    </label>
    <label
      class="net-check">
      <input
        type="checkbox"
        data-attr="place" />
      Your place
    </label>
  </div>

  <div
    class="net-label">
    <span>
      Viewpoint
    </span>
  </div>
  <div
    id="net-viewpoint"
    class="net-btn-group">
    <button
      class="net-btn"
      data-viewpoint="orbit">
      Orbit
    </button>
    <button
      class="net-btn"
      data-viewpoint="first">
      From your node
    </button>
  </div>

  <button
    id="net-grow"
    class="net-btn">
    Auto-grow connections
  </button>

  <div
    id="net-stats"
    class="net-stats">
  </div>

  <p
    class="net-hint">
    Click a second-hop person to be introduced through the mutual.
    Click a connection to cycle their network off, shared, full.
    Hover to isolate.
  </p>
</div>

<div
  id="net-sidebar"
  class="net-sidebar">
</div>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    window.network = window.socialNetwork();
  });
</script>
