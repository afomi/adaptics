<div
  id="rings-container"
  style="width: 100%; height: 100vh;">
</div>

<div
  id="rings-controls"
  style="position: absolute; top: 20px; left: 20px; z-index: 100; color: #fff; font-family: monospace; background: rgba(10,10,26,0.8); padding: 16px; border-radius: 8px; border: 1px solid #333;">
  <h3 style="margin: 0 0 8px 0; font-size: 14px; color: #ccddff;">
    Balancing 3 Rings
  </h3>
  <p style="margin: 0 0 12px 0; font-size: 11px; color: #8888aa;">
    Drag rings to reposition.
  </p>
  <p style="margin: 0 0 4px 0; font-size: 11px; color: #8888aa;">
    Splines show tension between rings.
  </p>
  <p style="margin: 0; font-size: 11px; color: #8888aa;">
    Color shifts green (balanced) → red (unbalanced).
  </p>
  <div
    id="rings-stats"
    style="margin-top: 12px; font-size: 12px; color: #66ffaa;">
  </div>
</div>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    window.balancingRings();
  });
</script>
