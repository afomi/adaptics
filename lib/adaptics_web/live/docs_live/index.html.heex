<div class="max-w-5xl mx-auto px-4 py-8 pt-16">
  <.header>
    Docs
    <:subtitle>
      Browse and view documents
    </:subtitle>
  </.header>

  <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <.link
      :for={doc <- @documents}
      navigate={~p"/docs/#{doc.id}"}
      class="block p-4 bg-white border border-zinc-200 rounded-lg hover:border-zinc-400 hover:shadow-sm transition"
    >
      <div class="flex items-start justify-between gap-2">
        <h3 class="text-sm font-semibold text-zinc-900 truncate">
          <%= doc.file_name %>
        </h3>
        <span class={"shrink-0 px-2 py-0.5 text-xs font-medium rounded-full #{status_badge_class(doc.status)}"}>
          <%= doc.status %>
        </span>
      </div>
      <p class="mt-2 text-xs text-zinc-500">
        <%= format_file_size(doc.file_size) %>
      </p>
    </.link>
  </div>

  <p
    :if={@documents == []}
    class="mt-8 text-sm text-zinc-500"
  >
    No documents yet. Upload documents from the
    <.link
      navigate={~p"/documents"}
      class="text-indigo-600 hover:text-indigo-800 font-medium"
    >
      Documents
    </.link>
    page.
  </p>
</div>
