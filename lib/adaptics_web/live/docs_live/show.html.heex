<div class="flex h-screen pt-10">
  <!-- Left sidebar: metadata -->
  <div class="w-80 shrink-0 border-r border-zinc-200 overflow-y-auto p-4 bg-zinc-50">
    <.back navigate={~p"/docs"}>Back to docs</.back>

    <h2 class="mt-4 text-sm font-semibold text-zinc-900 break-words">
      <%= @document.file_name %>
    </h2>

    <div class="mt-3 flex flex-wrap gap-2">
      <span class={"px-2 py-0.5 text-xs font-medium rounded-full #{status_badge_class(@document.status)}"}>
        <%= @document.status %>
      </span>
      <span class="px-2 py-0.5 text-xs text-zinc-500">
        <%= format_file_size(@document.file_size) %>
      </span>
    </div>

    <div
      :if={@document.schema_type}
      class="mt-3"
    >
      <span class="text-xs text-zinc-500">Schema type</span>
      <p class="text-sm text-zinc-900">
        <%= @document.schema_type %>
      </p>
    </div>

    <div
      :if={@document.content_type}
      class="mt-2"
    >
      <span class="text-xs text-zinc-500">Content type</span>
      <p class="text-sm text-zinc-900">
        <%= @document.content_type %>
      </p>
    </div>

    <!-- Grouped attributes -->
    <div
      :if={@grouped_attributes != []}
      class="mt-6 space-y-4"
    >
      <div :for={{key, attrs} <- @grouped_attributes}>
        <h3 class="flex items-center gap-1.5 text-xs font-medium text-zinc-500 uppercase tracking-wide">
          <.icon
            name={entity_type_icon(key)}
            class="h-3.5 w-3.5"
          />
          <%= entity_type_label(key) %>
          <span class="text-zinc-400">
            (<%= length(attrs) %>)
          </span>
        </h3>
        <div class="mt-1.5 flex flex-wrap gap-1">
          <span
            :for={attr <- attrs}
            class="inline-block px-2 py-0.5 text-xs rounded-full bg-zinc-200 text-zinc-700"
          >
            <%= attr.value %>
          </span>
        </div>
      </div>
    </div>

    <div
      :if={@grouped_attributes == []}
      class="mt-6 text-xs text-zinc-400"
    >
      No attributes extracted yet.
    </div>

    <div class="mt-6 pt-4 border-t border-zinc-200">
      <.link
        navigate={~p"/documents/#{@document.id}"}
        class="text-xs text-indigo-600 hover:text-indigo-800 font-medium"
      >
        Edit in Documents
      </.link>
    </div>
  </div>

  <!-- Center: document viewer -->
  <div class="flex-1 min-w-0 bg-zinc-100">
    <%= if pdf?(@document) do %>
      <iframe
        src={@file_url}
        class="w-full h-full"
        title={@document.file_name}
      />
    <% else %>
      <%= if image?(@document) do %>
        <div class="flex items-center justify-center h-full p-8">
          <img
            src={@file_url}
            alt={@document.file_name}
            class="max-w-full max-h-full object-contain"
          />
        </div>
      <% else %>
        <div class="flex items-center justify-center h-full">
          <div class="text-center text-zinc-400">
            <.icon
              name="hero-document"
              class="h-12 w-12 mx-auto"
            />
            <p class="mt-2 text-sm">
              Preview not available for this file type
            </p>
            <a
              href={@file_url}
              download
              class="mt-2 inline-block text-sm text-indigo-600 hover:text-indigo-800"
            >
              Download file
            </a>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <!-- Right sidebar: similar documents -->
  <div class="w-80 shrink-0 border-l border-zinc-200 overflow-y-auto p-4 bg-zinc-50">
    <h2 class="text-sm font-semibold text-zinc-900">
      Similar Documents
      <span
        :if={@similar_documents != []}
        class="ml-1 text-xs text-zinc-400 font-normal"
      >
        (<%= length(@similar_documents) %>)
      </span>
    </h2>

    <div
      :if={@similar_documents != []}
      class="mt-4 space-y-3"
    >
      <.link
        :for={%{document: sim_doc, shared_count: shared_count} <- @similar_documents}
        navigate={~p"/docs/#{sim_doc.id}"}
        class="block p-3 bg-white border border-zinc-200 rounded-lg hover:border-zinc-400 hover:shadow-sm transition"
      >
        <h3 class="text-sm font-medium text-zinc-900 truncate">
          <%= sim_doc.file_name %>
        </h3>
        <div class="mt-1.5 flex items-center gap-2">
          <span class="px-1.5 py-0.5 text-xs rounded bg-indigo-100 text-indigo-700">
            <%= shared_count %> shared
          </span>
          <span class="text-xs text-zinc-400">
            <%= format_file_size(sim_doc.file_size) %>
          </span>
        </div>
        <div
          :if={sim_doc.attributes != []}
          class="mt-2 flex flex-wrap gap-1"
        >
          <span
            :for={attr <- Enum.take(sim_doc.attributes, 5)}
            class="inline-block px-1.5 py-0.5 text-xs rounded bg-zinc-100 text-zinc-600"
          >
            <%= attr.value %>
          </span>
          <span
            :if={length(sim_doc.attributes) > 5}
            class="text-xs text-zinc-400"
          >
            +<%= length(sim_doc.attributes) - 5 %> more
          </span>
        </div>
      </.link>
    </div>

    <p
      :if={@similar_documents == []}
      class="mt-4 text-xs text-zinc-400"
    >
      No similar documents found.
    </p>
  </div>
</div>
