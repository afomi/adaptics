<div class="max-w-5xl mx-auto px-4 py-8 pt-16">
  <.back navigate={~p"/documents"}>Back to documents</.back>

  <.header class="mt-8">
    <%= @document.file_name %>
    <:subtitle>
      <span class={"px-2 py-1 text-xs font-medium rounded-full #{status_badge_class(@document.status)}"}>
        <%= @document.status %>
      </span>
      <span class="ml-2 text-zinc-500">
        <%= format_file_size(@document.file_size) %>
      </span>
    </:subtitle>
    <:actions>
      <button
        :if={@document.status == "ready" && @document.extracted_text}
        phx-click="run_extraction"
        class="text-sm font-semibold text-indigo-600 hover:text-indigo-800 mr-4"
      >
        Extract Entities
      </button>
      <.link
        phx-click="delete"
        data-confirm="Are you sure you want to delete this document?"
        class="text-sm font-semibold text-red-600 hover:text-red-800"
      >
        Delete document
      </.link>
    </:actions>
  </.header>

  <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 space-y-8">
      <div>
        <h2 class="text-base font-semibold text-zinc-900">
          Extracted Text
        </h2>

        <%= if @document.status == "extracting" do %>
          <div class="mt-4 flex items-center gap-2 text-sm text-zinc-500">
            <.icon
              name="hero-arrow-path"
              class="h-4 w-4 animate-spin"
            />
            Extracting text...
          </div>
        <% end %>

        <%= if @document.extracted_text do %>
          <pre class="mt-4 p-4 bg-zinc-50 rounded-lg text-sm text-zinc-700 whitespace-pre-wrap overflow-auto max-h-[600px] border border-zinc-200"><%= @document.extracted_text %></pre>
        <% end %>

        <%= if @document.status == "ready" && !@document.extracted_text do %>
          <p class="mt-4 text-sm text-zinc-500">
            No text could be extracted from this document.
          </p>
        <% end %>

        <%= if @document.status in ["pending", "uploaded"] do %>
          <p class="mt-4 text-sm text-zinc-500">
            Text extraction has not started yet.
          </p>
        <% end %>

        <%= if @document.status == "error" do %>
          <div class="mt-4 p-4 bg-red-50 rounded-lg text-sm text-red-700 border border-red-200">
            <p class="font-medium">
              Extraction failed
            </p>
            <p
              :if={@document.metadata["extraction_error"]}
              class="mt-1"
            >
              <%= @document.metadata["extraction_error"] %>
            </p>
          </div>
        <% end %>
      </div>

      <%= if @grouped_attributes != [] do %>
        <div>
          <h2 class="text-base font-semibold text-zinc-900">
            Extracted Entities
          </h2>

          <div class="mt-4 space-y-6">
            <div
              :for={{key, attrs} <- @grouped_attributes}
              :if={key in ~w(person organization location keyword geocoded_location)}
            >
              <h3 class="flex items-center gap-2 text-sm font-medium text-zinc-700">
                <.icon
                  name={entity_type_icon(key)}
                  class="h-4 w-4"
                />
                <%= entity_type_label(key) %>
                <span class="text-xs text-zinc-400">
                  (<%= length(attrs) %>)
                </span>
              </h3>
              <div class="mt-2 flex flex-wrap gap-2">
                <span
                  :for={attr <- attrs}
                  class={"inline-flex items-center gap-1 px-2.5 py-1 text-sm rounded-full #{source_badge_class(attr.source)}"}
                >
                  <%= attr.value %>
                  <button
                    phx-click="delete_attribute"
                    phx-value-id={attr.id}
                    data-confirm="Delete this entity?"
                    class="text-zinc-400 hover:text-red-600 ml-1"
                  >
                    <.icon
                      name="hero-x-mark"
                      class="h-3 w-3"
                    />
                  </button>
                </span>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="space-y-8">
      <div>
        <h2 class="text-base font-semibold text-zinc-900">
          Schema Type
        </h2>
        <form
          phx-submit="save_schema_type"
          class="mt-4 flex gap-2"
        >
          <select
            name="schema_type"
            class="block w-full rounded-md border border-gray-300 bg-white shadow-sm focus:border-zinc-400 focus:ring-0 sm:text-sm"
          >
            <option value="">
              None
            </option>
            <option
              value="ScholarlyArticle"
              selected={@document.schema_type == "ScholarlyArticle"}
            >
              ScholarlyArticle
            </option>
            <option
              value="Report"
              selected={@document.schema_type == "Report"}
            >
              Report
            </option>
            <option
              value="LegislativeDocument"
              selected={@document.schema_type == "LegislativeDocument"}
            >
              LegislativeDocument
            </option>
            <option
              value="GovernmentDocument"
              selected={@document.schema_type == "GovernmentDocument"}
            >
              GovernmentDocument
            </option>
            <option
              value="TechArticle"
              selected={@document.schema_type == "TechArticle"}
            >
              TechArticle
            </option>
            <option
              value="FinancialDocument"
              selected={@document.schema_type == "FinancialDocument"}
            >
              FinancialDocument
            </option>
          </select>
          <.button type="submit">
            Save
          </.button>
        </form>
      </div>

      <div>
        <h2 class="text-base font-semibold text-zinc-900">
          Attributes
        </h2>

        <div
          :if={@document.attributes != []}
          class="mt-4 space-y-2"
        >
          <div
            :for={attr <- Enum.filter(@document.attributes, &(&1.key not in ~w(person organization location keyword geocoded_location)))}
            class="flex items-center justify-between p-3 bg-zinc-50 rounded-lg"
          >
            <div>
              <span class="text-sm font-medium text-zinc-900">
                <%= attr.key %>
              </span>
              <span class={"ml-2 px-1.5 py-0.5 text-xs rounded #{source_badge_class(attr.source)}"}>
                <%= attr.source %>
              </span>
              <p class="text-sm text-zinc-600 mt-0.5">
                <%= attr.value %>
              </p>
            </div>
            <button
              phx-click="delete_attribute"
              phx-value-id={attr.id}
              class="text-zinc-400 hover:text-red-600"
              data-confirm="Delete this attribute?"
            >
              <.icon
                name="hero-trash"
                class="h-4 w-4"
              />
            </button>
          </div>
        </div>

        <.simple_form
          for={@attribute_form}
          phx-submit="save_attribute"
        >
          <.input
            field={@attribute_form[:key]}
            label="Key"
            placeholder="e.g. author, title, date"
          />
          <.input
            field={@attribute_form[:value]}
            type="textarea"
            label="Value"
            placeholder="Attribute value"
          />
          <:actions>
            <.button type="submit">
              Add Attribute
            </.button>
          </:actions>
        </.simple_form>
      </div>
    </div>
  </div>
</div>
