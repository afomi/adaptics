<div class="max-w-5xl mx-auto px-4 py-8 pt-16">
  <.header>
    tldraw Canvas
    <:subtitle>
      <%= @file_path %>
    </:subtitle>
    <:actions>
      <button
        phx-click="reload"
        class="px-3 py-1.5 text-sm bg-zinc-100 hover:bg-zinc-200 rounded-md text-zinc-700"
      >
        Reload file
      </button>
    </:actions>
  </.header>

  <p
    :if={@error}
    class="mt-4 p-3 bg-red-50 text-red-700 rounded-md text-sm"
  >
    <%= @error %>
  </p>

  <div :if={@summary}>
    <%!-- Summary --%>
    <div class="mt-6 grid grid-cols-3 gap-4">
      <div class="p-4 bg-zinc-50 rounded-lg">
        <p class="text-2xl font-bold text-zinc-900">
          <%= @summary.shape_count %>
        </p>
        <p class="text-sm text-zinc-500">
          Shapes
        </p>
      </div>
      <div class="p-4 bg-zinc-50 rounded-lg">
        <p class="text-2xl font-bold text-zinc-900">
          <%= @summary.binding_count %>
        </p>
        <p class="text-sm text-zinc-500">
          Bindings
        </p>
      </div>
      <div class="p-4 bg-zinc-50 rounded-lg">
        <p class="text-2xl font-bold text-zinc-900">
          <%= @summary.page_count %>
        </p>
        <p class="text-sm text-zinc-500">
          Pages
        </p>
      </div>
    </div>

    <%!-- Types breakdown --%>
    <div class="mt-6">
      <h3 class="text-sm font-semibold text-zinc-700">
        Shape types
      </h3>
      <div class="mt-2 flex flex-wrap gap-2">
        <span
          :for={{type, count} <- @summary.types}
          class="inline-flex items-center gap-1 px-2.5 py-1 bg-indigo-50 text-indigo-700 text-xs font-medium rounded-full"
        >
          <%= type %>
          <span class="text-indigo-400">
            <%= count %>
          </span>
        </span>
      </div>
    </div>

    <%!-- Search --%>
    <div class="mt-8">
      <h3 class="text-sm font-semibold text-zinc-700 mb-2">
        Search shapes
      </h3>
      <form
        phx-change="search"
        phx-submit="search"
      >
        <input
          type="text"
          name="query"
          value={@search_query}
          placeholder="Search text content..."
          class="w-full px-3 py-2 border border-zinc-300 rounded-md text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500"
          phx-debounce="300"
        />
      </form>
      <div
        :if={@search_results != []}
        class="mt-3 space-y-2"
      >
        <div
          :for={shape <- @search_results}
          class="p-3 bg-white border border-zinc-200 rounded-md"
        >
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 text-xs font-medium bg-zinc-100 text-zinc-600 rounded">
              <%= shape.type %>
            </span>
            <span class="text-xs text-zinc-400 font-mono truncate">
              <%= shape.id %>
            </span>
          </div>
          <p
            :if={shape.text}
            class="mt-1 text-sm text-zinc-900"
          >
            <%= shape.text %>
          </p>
          <p
            :if={shape.name}
            class="mt-1 text-sm text-zinc-500 italic"
          >
            <%= shape.name %>
          </p>
        </div>
      </div>
      <p
        :if={@search_query != "" and @search_results == []}
        class="mt-3 text-sm text-zinc-500"
      >
        No shapes match "<%= @search_query %>"
      </p>
    </div>

    <%!-- Frames (Sets) --%>
    <div class="mt-8">
      <h3 class="text-sm font-semibold text-zinc-700 mb-2">
        Frames (sets)
      </h3>
      <div
        :if={@summary.frames == []}
        class="text-sm text-zinc-500"
      >
        No frames in this canvas.
      </div>
      <div class="space-y-2">
        <div
          :for={frame <- @summary.frames}
          class="p-3 bg-white border border-zinc-200 rounded-md"
        >
          <div class="flex items-center justify-between">
            <div>
              <span class="text-sm font-medium text-zinc-900">
                <%= frame.name || "(unnamed)" %>
              </span>
              <span class="ml-2 text-xs text-zinc-400">
                <%= frame.member_count %> members
              </span>
            </div>
            <button
              phx-click="select_frame"
              phx-value-id={frame.id}
              class="text-xs text-indigo-600 hover:text-indigo-800"
            >
              Show members
            </button>
          </div>
        </div>
      </div>
    </div>

    <%!-- Frame members panel --%>
    <div
      :if={@selected_frame}
      class="mt-4 p-4 bg-indigo-50 border border-indigo-200 rounded-md"
    >
      <div class="flex items-center justify-between mb-3">
        <h4 class="text-sm font-semibold text-indigo-900">
          Members of <%= @selected_frame %>
        </h4>
        <button
          phx-click="clear_frame"
          class="text-xs text-indigo-600 hover:text-indigo-800"
        >
          Close
        </button>
      </div>
      <div
        :if={@frame_members == []}
        class="text-sm text-indigo-700"
      >
        No members in this frame.
      </div>
      <div class="space-y-1">
        <div
          :for={member <- @frame_members}
          class="p-2 bg-white rounded text-sm"
        >
          <span class="px-1.5 py-0.5 text-xs bg-zinc-100 text-zinc-600 rounded">
            <%= member.type %>
          </span>
          <span :if={member.text} class="ml-2 text-zinc-900">
            <%= member.text %>
          </span>
          <span :if={member.name} class="ml-2 text-zinc-500 italic">
            <%= member.name %>
          </span>
        </div>
      </div>
    </div>

    <%!-- Text content --%>
    <div class="mt-8">
      <h3 class="text-sm font-semibold text-zinc-700 mb-2">
        Text content
      </h3>
      <div
        :if={@summary.texts == []}
        class="text-sm text-zinc-500"
      >
        No text content in this canvas.
      </div>
      <div class="space-y-1">
        <div
          :for={entry <- @summary.texts}
          class="flex items-start gap-2 py-1"
        >
          <span class="text-xs text-zinc-400 font-mono shrink-0 mt-0.5 truncate max-w-[200px]">
            <%= entry.shape_id %>
          </span>
          <span class="text-sm text-zinc-900">
            <%= entry.text %>
          </span>
        </div>
      </div>
    </div>

    <%!-- Duplicates --%>
    <div
      :if={@summary.duplicates != []}
      class="mt-8"
    >
      <h3 class="text-sm font-semibold text-amber-700 mb-2">
        Possible shared concepts (duplicate labels)
      </h3>
      <div class="space-y-2">
        <div
          :for={{text, shapes} <- @summary.duplicates}
          class="p-3 bg-amber-50 border border-amber-200 rounded-md"
        >
          <p class="text-sm font-medium text-amber-900">
            "<%= text %>"
          </p>
          <p class="text-xs text-amber-700 mt-1">
            Found in <%= length(shapes) %> locations across different frames
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
