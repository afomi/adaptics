<div
  :for={hit <- @hits}
  id={"hit-#{hit.id}"}
  class="mb-5"
>
  <.link
    navigate={~p"/transcripts/#{hit.slug}/#{hit.id}"}
    class="font-medium text-zinc-900 hover:underline"
  >
    {hit.title}
  </.link>
  <span class="text-xs text-zinc-500">
    · {plural(length(hit.turns), "turn")} · {ago(hit.modified)}
  </span>
  <ul class="mt-1 space-y-1 text-xs">
    <li :for={turn <- Enum.take(hit.turns, @max_turns)}>
      <a
        href={~p"/transcripts/#{hit.slug}/#{hit.id}" <> "#turn-#{turn.number}"}
        class="flex gap-2 rounded px-2 py-1 hover:bg-zinc-50"
      >
        <span class="w-8 shrink-0 text-right text-zinc-400">#{turn.number}</span>
        <span class="text-zinc-600">
          {elem(turn.snippet, 0)}<mark class="bg-yellow-200 text-zinc-900">{elem(turn.snippet, 1)}</mark>{elem(turn.snippet, 2)}
        </span>
      </a>
    </li>
    <li
      :if={length(hit.turns) > @max_turns}
      class="px-2 py-1 pl-12"
    >
      <.link
        navigate={~p"/transcripts/#{hit.slug}/#{hit.id}"}
        class="text-indigo-600 hover:underline"
      >
        +{length(hit.turns) - @max_turns} more in this session
      </.link>
    </li>
  </ul>
</div>
