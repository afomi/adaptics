<div class="max-w-4xl mx-auto px-4 py-8">
  <h1 class="text-2xl font-bold mb-6"><%= @page_title %></h1>

  <.simple_form
    for={@form}
    id="wiki-page-form"
    phx-change="validate"
    phx-submit="save"
  >
    <.input
      field={@form[:title]}
      type="text"
      label="Title"
    />
    <.input
      field={@form[:body]}
      type="textarea"
      label="Body (Markdown)"
      rows="16"
      phx-debounce="500"
    />

    <div class="text-sm text-gray-500 mt-1">
      Use <code class="bg-gray-100 px-1 rounded">[[Page Name]]</code> to link to other wiki pages.
      Use <code class="bg-gray-100 px-1 rounded">[[Page Name|display text]]</code> for alternate link text.
    </div>

    <:actions>
      <.button
        type="submit"
        phx-disable-with="Saving..."
      >
        Save Page
      </.button>
      <.link
        :if={@live_action == :edit}
        navigate={~p"/wiki/#{@page.slug}"}
        class="text-sm text-gray-500 hover:text-gray-700 ml-4"
      >
        Cancel
      </.link>
      <.link
        :if={@live_action == :new}
        navigate={~p"/wiki"}
        class="text-sm text-gray-500 hover:text-gray-700 ml-4"
      >
        Cancel
      </.link>
    </:actions>
  </.simple_form>

  <div :if={@preview_html != ""} class="mt-8">
    <h2 class="text-lg font-semibold mb-3 text-gray-700">Preview</h2>
    <div class="prose prose-indigo max-w-none border rounded-md p-4 bg-gray-50">
      <%= raw(@preview_html) %>
    </div>
  </div>
</div>
