// Initialize Three.js
const scene = new THREE.Scene();
scene.background = new THREE.Color(0xf0f0f0);  // Light grey background

const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
const renderer = new THREE.WebGLRenderer();
renderer.setSize(window.innerWidth, window.innerHeight);
document.body.appendChild(renderer.domElement);

// Add a simple box for each employee
employees.forEach((employee, index) => {
    const geometry = new THREE.BoxGeometry();
    const material = new THREE.MeshBasicMaterial({ color: 0x00ff00 });
    const cube = new THREE.Mesh(geometry, material);

    // Position the boxes in a grid
    cube.position.x = (index % 10) * 1.5;
    cube.position.y = Math.floor(index / 10) * 1.5;
    cube.position.z = 0;

    // Add the box to the scene
    scene.add(cube);

    // Create a text label for the employee
    const canvas = document.createElement('canvas');
    const context = canvas.getContext('2d');
    context.fillStyle = '#f0f0f0';  // White background for the text box
    context.fillRect(0, 0, canvas.width, canvas.height);
    context.font = '48px Arial';
    context.fillStyle = '#f0f0f0';
    context.fillText(`${employee.first_name} ${employee.last_name}`, 10, 50);
    context.fillText(employee.title, 10, 100);

    // Create a texture from the canvas and apply it to a plane
    const texture = new THREE.CanvasTexture(canvas);
    const textMaterial = new THREE.MeshBasicMaterial({ map: texture });
    const textGeometry = new THREE.PlaneGeometry(1, 0.5);
    const textMesh = new THREE.Mesh(textGeometry, textMaterial);
    textMesh.position.set(cube.position.x, cube.position.y, cube.position.z + 1);

    // Add the text to the scene
    scene.add(textMesh);
});

camera.position.x = 2;
camera.position.y = 7;
camera.position.z = 20;

// camera.position.z = 10;
