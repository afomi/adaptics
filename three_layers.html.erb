<% content_for :title do %>Three Layers<% end %>

<div class="min-h-screen bg-gray-900">
  <div class="p-4">
    <h1 class="text-2xl font-bold text-white mb-2">Three Layers</h1>
    <p class="text-gray-400 text-sm mb-4">
      Three.js layered visualization
    </p>
  </div>

  <div
    id="canvas-container"
    class="w-full"
    style="height: 70vh;">
  </div>

  <div class="p-4">
    <a
      href="/ui"
      class="text-gray-400 hover:text-white text-sm">
      ← Back to UI
    </a>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
  const container = document.getElementById('canvas-container');
  if (container) {
    const width = container.clientWidth;
    const height = container.clientHeight;

    // Scene
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x111827);

    // Camera
    const camera = new THREE.PerspectiveCamera(75, width / height, 0.1, 1000);
    camera.position.z = 3.5;

    // Renderer
    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(width, height);
    renderer.setPixelRatio(window.devicePixelRatio);
    container.appendChild(renderer.domElement);

    // Create three layers of geometry
    const layers = [];
    const colors = [0x3b82f6, 0x10b981, 0xf59e0b]; // blue, green, amber
    const layerSpacing = 1.5;

    for (let i = 0; i < 3; i++) {
      const geometry = new THREE.PlaneGeometry(2, 2);
      const material = new THREE.MeshBasicMaterial({
        color: colors[i],
        transparent: true,
        opacity: 0.7,
        side: THREE.DoubleSide
      });
      const plane = new THREE.Mesh(geometry, material);
      plane.position.z = (i - 1) * layerSpacing;
      plane.rotation.x = Math.PI * 0.1;
      scene.add(plane);
      layers.push(plane);
    }

    // Mouse interaction
    let mouseX = 0, mouseY = 0;
    document.addEventListener('mousemove', (event) => {
      mouseX = (event.clientX / window.innerWidth) * 2 - 1;
      mouseY = -(event.clientY / window.innerHeight) * 2 + 1;
    });

    // Animation
    function animate() {
      requestAnimationFrame(animate);

      // Rotate layers based on mouse
      layers.forEach((layer, i) => {
        layer.rotation.y = mouseX * 0.8 * (i + 1) * 0.4;
        layer.rotation.x = Math.PI * 0.1 + mouseY * 0.6 * (i + 1) * 0.3;
      });

      renderer.render(scene, camera);
    }

    animate();

    // Handle resize
    window.addEventListener('resize', () => {
      const newWidth = container.clientWidth;
      const newHeight = container.clientHeight;
      camera.aspect = newWidth / newHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(newWidth, newHeight);
    });
  }
</script>
